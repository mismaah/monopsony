# Copy to deploy/.env (gitignored). docker compose reads it from the directory
# of the compose file.

# Long random string, e.g. `openssl rand -base64 48`.
MONOPSONY_JWT_SECRET=
# The hostname you attached to the tunnel, with scheme.
MONOPSONY_PUBLIC_URL=https://beta.example.com
# Comma-separated emails that get the admin role (register with one of them).
MONOPSONY_ADMIN_EMAILS=

# The Postgres running on the host. host.docker.internal is the host as seen
# from the container; Postgres must accept connections from the Docker bridge
# (README → Production). The server applies its own migrations on boot.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=monopsony
POSTGRES_USER=monopsony
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# fake = every purchase completes instantly and for free (fine for a beta where
# everyone should have premium). stripe needs the two keys below and a priceId
# on the plan (admin → Plans); exempt /api/billing/webhook from any geo rule.
MONOPSONY_BILLING_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# none | house | adsense
MONOPSONY_ADS_PROVIDER=house
MONOPSONY_ADSENSE_CLIENT=
MONOPSONY_ADSENSE_SLOT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
