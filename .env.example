# ---- server ------------------------------------------------------------------
# 127.0.0.1 keeps dev off the LAN and stops Windows Firewall prompting on every restart.
# Use :8080 to listen on all interfaces (e.g. testing from a phone).
MONOPSONY_ADDR=127.0.0.1:8080
MONOPSONY_ENV=dev                      # prod enables Secure cookies
MONOPSONY_PUBLIC_URL=http://localhost:5173
MONOPSONY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MONOPSONY_JWT_SECRET=change-me-in-prod
# Leave unset to run on the in-memory store (dev only, nothing persists).
MONOPSONY_DATABASE_URL=postgres://monopsony:monopsony@localhost:5432/monopsony?sslmode=disable
# Comma-separated emails that get the admin role on register/login.
MONOPSONY_ADMIN_EMAILS=
# Delay before bots act (ms) so animations can play.
MONOPSONY_BOT_DELAY_MS=900
# Serve built SPAs from this directory (single-binary deploy).
# MONOPSONY_STATIC_DIR=../apps/web/dist
# Logging: level debug|info|warn|error, format text|json.
MONOPSONY_LOG_LEVEL=info
MONOPSONY_LOG_FORMAT=text

# ---- hardening -----------------------------------------------------------------
# Prometheus metrics listener (separate port, keep it internal); "off" disables.
MONOPSONY_METRICS_ADDR=127.0.0.1:9100
# Per-client-IP budgets as "per-minute/burst"; "0" disables one limiter.
MONOPSONY_RATE_AUTH=20/10
MONOPSONY_RATE_API=300/60
MONOPSONY_RATE_WS=30/10
# Per-connection WebSocket budgets.
MONOPSONY_RATE_WS_FRAMES=600/60
MONOPSONY_RATE_WS_CHAT=30/5
# Set to 1 only behind a proxy you control (honours X-Forwarded-For).
MONOPSONY_TRUST_PROXY=0

# ---- multi-node -------------------------------------------------------------------
# Every server sharing this Redis (and the same Postgres) forms one cluster;
# games are reachable from any node. Unset = single node.
# MONOPSONY_REDIS_URL=redis://localhost:6379/0
# MONOPSONY_NODE_ID=node-1

# ---- cosmetics assets ----------------------------------------------------------
# Admin-uploaded glTF/textures are stored here and served under /media/.
# "off" disables uploads (manifests can still use bundled models / https URLs).
MONOPSONY_ASSET_DIR=./data/assets

# ---- ads (free tier) -------------------------------------------------------------
# none | house (built-in upgrade promo) | adsense
MONOPSONY_ADS_PROVIDER=house
MONOPSONY_ADSENSE_CLIENT=
MONOPSONY_ADSENSE_SLOT=
MONOPSONY_ADS_NON_PERSONALIZED=0

# ---- billing -----------------------------------------------------------------
MONOPSONY_BILLING_PROVIDER=fake        # fake | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- oauth (optional) ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- tests ---------------------------------------------------------------------
# Runs the store conformance tests against Postgres as well as the in-memory store.
MONOPSONY_TEST_DATABASE_URL=postgres://monopsony:monopsony@localhost:5432/monopsony?sslmode=disable
# Runs the cluster bus conformance test against a real Redis.
MONOPSONY_TEST_REDIS_URL=redis://localhost:6379/1
# Used by `task assets:upload` (or MONOPSONY_ADMIN_TOKEN).
MONOPSONY_URL=http://localhost:8080
MONOPSONY_ADMIN_EMAIL=
MONOPSONY_ADMIN_PASSWORD=
